# Copiar como .env y reemplazar los valores antes de iniciar n8n.
# No subir este archivo .env a Git.
N8N_ENCRYPTION_KEY=generar-una-clave-larga-y-unica
N8N_USER_MANAGEMENT_JWT_SECRET=generar-otro-secreto-largo-y-unico
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambiar-por-una-clave-segura

# Modo Sabor expone estas rutas para que n8n consulte y cotice siempre contra
# el catalogo real. La clave debe ser el mismo AGENT_API_KEY del backend.
MODO_SABOR_API_URL=https://modosabor.com.ar
AGENT_API_KEY=pegar-clave-del-agente

# NVIDIA NIM: se configura como credencial "OpenAI" dentro de n8n.
NVIDIA_API_KEY=pegar-clave-de-build-nvidia
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2

# Solo para el puente QR en modo piloto. No habilita respuestas automaticas.
