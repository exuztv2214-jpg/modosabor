# Archivos de configuración local de Claude Code (contienen credenciales y comandos sensibles)
.claude/settings.local.json

# Temporales de trabajo. Se juntaban en la raiz —previews de tickets, un logo
# descargado, logs de arranque— y ensuciaban git status hasta tapar lo que uno
# estaba tocando de verdad.
.tmp-*/
logs-arranque.txt
*.log

# La base local. `server/*.db` no alcanzaba: el archivo vive un nivel mas
# adentro, en server/db/, y los -journal/-wal/-shm ni figuraban.
server/db/*.db
server/db/*.db-journal
server/db/*.db-shm
server/db/*.db-wal
server/uploads/logo-prueba.*

# Medios operativos generados o cargados desde los paneles. Viven en el
# volumen persistente; no son código y pueden contener material de clientes.
server/uploads/social-avatares/
server/uploads/social-media/
server/uploads/whatsapp-campanas/
server/uploads/whatsapp-fotos/
server/uploads/whatsapp-carta/*.pdf

# Las bases de n8n. Quedan sueltas en la raiz al depurar el workflow del
# agente y NO pueden entrar a git: cada una guarda 4 credenciales adentro.
# La regla de mas arriba (agente-whatsapp/n8n/n8n-debug.sqlite*) solo tapaba
# las de esa carpeta; estas viven en la raiz y estaban quedando afuera.
*.sqlite
*.sqlite-shm
*.sqlite-wal

# El workflow activo exportado: sale de n8n con los datos de conexion puestos.
agente-whatsapp/n8n/.active-workflow.json
