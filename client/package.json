{
  "name": "modosabor-client",
  "version": "1.3.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "build:native": "vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\" && cap sync",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "android:debug": "npm run build:native && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run build:native && cd android && gradlew.bat bundleRelease",
    "android:release-apk": "npm run build:native && cd android && gradlew.bat assembleRelease",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "axios": "^1.18.1",
    "date-fns": "^3.3.1",
    "framer-motion": "^12.42.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.12.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@eslint/js": "^9.15.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.15.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.1",
    "vite": "^8.1.0"
  },
  "overrides": {
    "engine.io-client": "6.6.6",
    "form-data": "4.0.6",
    "socket.io-parser": "4.2.7"
  }
}
