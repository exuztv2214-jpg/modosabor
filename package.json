{
  "name": "modosabor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run start",
    "client": "npm --prefix client run dev",
    "setup": "npm install && npm --prefix server install && npm --prefix client install",
    "smoke": "npm --prefix server run smoke",
    "verify:core": "npm --prefix server run verify:core",
    "verify:operacion": "npm --prefix server run verify:operacion",
    "build": "npm --prefix client run build",
    "native:build": "npm --prefix client run build:native",
    "native:android:debug": "powershell -ExecutionPolicy Bypass -File ./deploy/build-rider-apk.ps1",
    "native:android:release": "npm --prefix client run android:release",
    "native:android:open": "npm --prefix client run cap:open:android",
    "lint": "npm run lint:client && npm run lint:server",
    "lint:client": "npm --prefix client run lint",
    "lint:server": "npm --prefix server run lint",
    "lint:fix": "npm run lint:client -- --fix && npm run lint:server -- --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,css}\"",
    "whatsapp:bridge:install": "npm --prefix agente-whatsapp/puente-web install",
    "whatsapp:bridge": "npm --prefix agente-whatsapp/puente-web start",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.15.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,json,md,css}": "prettier --write"
  }
}
