PORT=3001
NODE_ENV=production
# Cantidad de proxies confiables delante de Express (Railway: 1).
TRUST_PROXY=1
JWT_SECRET=cambia-esta-clave-larga-y-segura
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@tudominio.com
INITIAL_ADMIN_PASSWORD=cambia-esta-clave-inicial
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.92:5173,https://tu-dominio.com,https://www.tu-dominio.com
PUBLIC_APP_URL=https://tu-dominio.com
PUBLIC_API_URL=https://tu-dominio.com
DATA_DIR=/data
UPLOADS_DIR=/data/uploads
BACKUPS_DIR=/data/backups
DB_FILE=/data/modosabor.db
# JSON completo de una cuenta de servicio del proyecto Firebase modosabor-rider.
# Sólo cargarlo como variable protegida de Railway; nunca versionarlo.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Transcripción local de notas de voz de WhatsApp (sin API paga).
# El instalador local crea server/.venv-whisper; en Linux puede apuntarse a python3.
WHISPER_PYTHON=
WHISPER_MODEL=base
WHISPER_CACHE_DIR=
WHISPER_INITIAL_PROMPT=
WHATSAPP_AGENT_WEBHOOK_URL=http://127.0.0.1:5678/webhook/modosabor-atencion-web
WHATSAPP_AGENT_FALLBACK_WEBHOOK_URL=http://127.0.0.1:5678/webhook/modosabor-atencion-web-fallback
