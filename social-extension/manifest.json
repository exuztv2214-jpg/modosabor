{
  "manifest_version": 3,
  "name": "Modo Sabor Social",
  "version": "2.0.0",
  "description": "Publica texto y fotos en tus grupos de Facebook desde el panel de Modo Sabor, usando tu propia sesión.",

  "icons": {
    "16": "icons/icono-16.png",
    "32": "icons/icono-32.png",
    "48": "icons/icono-48.png",
    "128": "icons/icono-128.png"
  },

  "permissions": ["storage", "alarms", "tabs", "scripting", "notifications"],

  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "http://localhost/*",
    "https://modosabor.com.ar/*",
    "https://www.modosabor.com.ar/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Modo Sabor Social",
    "default_icon": {
      "16": "icons/icono-16.png",
      "32": "icons/icono-32.png",
      "48": "icons/icono-48.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://modosabor.com.ar/*",
        "https://www.modosabor.com.ar/*"
      ],
      "js": ["puente-panel.js"],
      "run_at": "document_start"
    }
  ]
}
