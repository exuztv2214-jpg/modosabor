# Copiá este archivo como .env. Nunca lo subas a git.
# Railway y este worker deben usar exactamente la misma SOCIAL_WORKER_KEY.
SOCIAL_WORKER_KEY=

# Producción: https://tu-dominio/api/social-worker
# Desarrollo local: http://localhost:3001/api/social-worker
SOCIAL_API_URL=http://localhost:3001/api/social-worker

# CDP se limita deliberadamente a Chrome local.
SOCIAL_CHROME_CDP_URL=http://127.0.0.1:9222
SOCIAL_WORKER_CODE=windows-local
SOCIAL_POLL_MS=8000
# 1 sólo durante validación E2E: captura visual sin cookies ni HTML al fallar.
SOCIAL_CAPTURE_FAILURE_SCREENSHOTS=0
